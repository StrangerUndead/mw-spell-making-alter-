{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lostart.invalid/schema/spellmakers.schema.json",
  "title": "NPC spellmakers (data/content/spellmakers.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spellmakers"
  ],
  "properties": {
    "spellmakers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "npc",
          "name",
          "location",
          "refusal",
          "merchantChest",
          "priceMult",
          "specialties"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "npc": {
            "$ref": "common.schema.json#/$defs/formRef"
          },
          "npcLabel": {
            "$ref": "common.schema.json#/$defs/editorId"
          },
          "name": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "locationRef": {
            "$ref": "common.schema.json#/$defs/formRef"
          },
          "refusal": {
            "type": "string",
            "pattern": "^(college|anyone|wanted:(Haafingar|Whiterun|Eastmarch|Rift|Reach|Pale|Hjaalmarch|Falkreath|Winterhold)|quest:(Skyrim|Dawnguard|Dragonborn)\\.esm\\|0x[0-9A-F]{6}:[0-9]+)$"
          },
          "crimeFaction": {
            "$ref": "common.schema.json#/$defs/formRef"
          },
          "merchantChest": {
            "$ref": "common.schema.json#/$defs/formRefOrNull"
          },
          "priceMult": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "specialties": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/mwSchool"
            }
          },
          "refusalLine": {
            "$ref": "common.schema.json#/$defs/translationKey"
          },
          "questLabel": {
            "type": "string"
          },
          "verify": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        },
        "if": {
          "properties": {
            "refusal": {
              "pattern": "^wanted:"
            }
          }
        },
        "then": {
          "required": [
            "crimeFaction"
          ]
        }
      }
    },
    "universalRules": {
      "type": "array",
      "items": {
        "enum": [
          "vampireStage4",
          "relationshipBelowAcquaintance",
          "serviceDisabled"
        ]
      }
    },
    "collegeFaction": {
      "$ref": "common.schema.json#/$defs/formRef"
    },
    "holds": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "crimeFaction"
        ],
        "properties": {
          "crimeFaction": {
            "$ref": "common.schema.json#/$defs/formRef"
          }
        }
      }
    },
    "refusalReasons": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
