{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lostart.invalid/schema/attributes.schema.json",
  "title": "Attribute translation (data/content/attributes.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attributes",
    "effects"
  ],
  "properties": {
    "attributes": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "name",
          "nameKey",
          "stats"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "name": {
            "type": "string"
          },
          "nameKey": {
            "$ref": "common.schema.json#/$defs/translationKey"
          },
          "stats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stat",
                "perPoint"
              ],
              "properties": {
                "stat": {
                  "enum": [
                    "CarryWeight",
                    "MeleeDamagePercent",
                    "Magicka",
                    "MagickaRatePercent",
                    "MagicResist",
                    "AttackSpeedPercent",
                    "EvasionPercent",
                    "SpeedMult",
                    "Health",
                    "StaminaRatePercent",
                    "Speech",
                    "PricePercent",
                    "PickpocketPercent"
                  ]
                },
                "perPoint": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        }
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/effectId"
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "singleEffectAttributes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
